@@ -0,0 +1,69 @@
+package com.moddingfromamod.rules;
+
+import com.moddingfromamod.ModdingFromAModMod;
+import com.moddingfromamod.compat.Target;
+import com.moddingfromamod.testing.gt.GameTest;
+import com.moddingfromamod.testing.gt.GameTestHolder;
+import java.util.List;
+import net.minecraft.gametest.framework.GameTestHelper;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.nbt.ListTag;
+import net.minecraft.nbt.StringTag;
+import net.minecraft.network.chat.Component;
+
+/**
+ * <b>A world rule saved on 1.21.8 still knows its block</b>: the structured one-id {@code block} of a {@code near_block}
+ * rule reads as 1.21.10 calls it, through the store's own load ({@link WorldRules.Store}); its commands are text and are
+ * not touched (an id inside a command is CBScript's per-version business). A store a newer Minecraft wrote is read as it
+ * is, is not writable, and is saved back unchanged.
+ */
+@GameTestHolder(ModdingFromAModMod.MODID)
+public class WorldRulesRenamesGameTest {
+
+    static final String RULE = "{\"name\":\"gt_rename_rule\",\"when\":\"near_block\",\"block\":\"minecraft:chain\","
+            + "\"radius\":2,\"seconds\":10,\"chance\":1.0,\"do\":[\"setblock ~ ~1 ~ minecraft:chain\"]}";
+
+    static CompoundTag rules1218() {
+        ListTag list = new ListTag();
+        list.add(StringTag.valueOf(RULE));
+        CompoundTag tag = new CompoundTag();
+        tag.putInt("v", 1);
+        tag.put("rules", list);
+        return tag;
+    }
+
+    @GameTest(template = "empty_test", batch = "block_renames", timeoutTicks = 100)
+    public static void aNearBlockRuleSavedOn1218ReadsIronChain(GameTestHelper helper) {
+        var lookup = helper.getLevel().registryAccess();
+        WorldRules.Store s = WorldRules.Store.load(rules1218(), lookup);
+        WorldRule r = s.rules.get("gt_rename_rule");
+        helper.assertTrue(r != null, Component.literal("the 1.21.8 rule did not read"));
+        helper.assertTrue("minecraft:iron_chain".equals(r.block()),
+                Component.literal("the rule's block read as " + r.block() + ", not minecraft:iron_chain"));
+        helper.assertTrue(r.commands().equals(List.of("setblock ~ ~1 ~ minecraft:chain")),
+                Component.literal("the rule's command text was changed: " + r.commands()));
+        helper.assertTrue(s.readOnly == null && s.refused == null, Component.literal("a 1.21.8 store is ours to write"));
+        CompoundTag saved = s.save(new CompoundTag(), lookup);
+        helper.assertTrue(Target.MINECRAFT.equals(saved.getStringOr("mc", "")),
+                Component.literal("a save does not stamp this Minecraft: " + saved));
+        WorldRule again = WorldRules.Store.load(saved, lookup).rules.get("gt_rename_rule");
+        helper.assertTrue(again != null && "minecraft:iron_chain".equals(again.block()),
+                Component.literal("the saved rule did not read back: " + again));
+        helper.succeed();
+    }
+
+    @GameTest(template = "empty_test", batch = "block_renames", timeoutTicks = 100)
+    public static void rulesFromANewerMinecraftAreReadButNeverWrittenOver(GameTestHelper helper) {
+        var lookup = helper.getLevel().registryAccess();
+        CompoundTag tag = rules1218();
+        tag.putString("mc", "1.22");
+        WorldRules.Store s = WorldRules.Store.load(tag, lookup);
+        helper.assertTrue(s.readOnly != null, Component.literal("a newer Minecraft's rules were not marked read-only"));
+        WorldRule r = s.rules.get("gt_rename_rule");
+        helper.assertTrue(r != null && "minecraft:chain".equals(r.block()),
+                Component.literal("a newer Minecraft's rule was not read as it is: " + r));
+        helper.assertTrue(s.save(new CompoundTag(), lookup).equals(tag),
+                Component.literal("a save wrote over a newer Minecraft's rules"));
+        helper.succeed();
+    }
+}
