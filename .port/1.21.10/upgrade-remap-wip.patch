+                 "cmd":"setblock ~ ~ ~ minecraft:chain","arr":["minecraft:chain","#minecraft:logs","minecraft:stone"],
+                 "num":3}""").getAsJsonObject();
+        for (String k : new String[] {"block", "bare", "tag", "list", "cmd", "arr", "num", "absent"}) {
+            BlockRenames.remapField(o, k, "1.21.8", "1.21.10", false);
+        }
+        assertEquals("minecraft:iron_chain", o.get("block").getAsString());
+        assertEquals("iron_chain", o.get("bare").getAsString());
+        assertEquals("#minecraft:chains", o.get("tag").getAsString(), "a tag is left alone");
+        assertEquals("minecraft:chain,minecraft:stone", o.get("list").getAsString(), "a comma list is not one id");
+        assertEquals("setblock ~ ~ ~ minecraft:chain", o.get("cmd").getAsString(), "command text is CBScript's");
+        assertEquals(JsonParser.parseString("[\"minecraft:iron_chain\",\"#minecraft:logs\",\"minecraft:stone\"]"),
+                o.get("arr"), "each one-id element of a list of ids");
+        assertEquals(3, o.get("num").getAsInt());
+        assertFalse(BlockRenames.remapField(o, "block", "1.21.10", "1.21.10", false), "a marked field is not remapped");
+    }
+
+    @Test
+    void a_field_that_may_name_an_item_takes_only_rows_that_renamed_the_item_too() {
+        assertEquals("minecraft:iron_chain", BlockRenames.remapBlockOrItem("minecraft:chain", "1.21.8", "1.21.10"),
+                "chain's item was renamed with its block");
+        List<BlockRenames.Row> blockOnly = List.of(new BlockRenames.Row("minecraft:old_wall", "minecraft:new_wall", "1.21.9",
+                false));
+        assertEquals("minecraft:new_wall", BlockRenames.remap(blockOnly, "minecraft:old_wall", "1.21.8", "1.21.10", false));
+        assertEquals("minecraft:old_wall", BlockRenames.remap(blockOnly, "minecraft:old_wall", "1.21.8", "1.21.10", true),
+                "an item id the rename never touched is left alone");
+    }
+
+    @Test
+    void a_record_written_for_a_newer_minecraft_is_newer() {
+        assertTrue(BlockRenames.newer("1.21.11", "1.21.10"));
+        assertTrue(BlockRenames.newer("1.22", "1.21.10"));
+        assertFalse(BlockRenames.newer("1.21.10", "1.21.10"));
+        assertFalse(BlockRenames.newer(BlockRenames.PRE_MARKER, "1.21.10"));
+    }
+
     private static JsonObject byIdRecord(List<JsonObject> records, String id) {
         return records.stream().filter(r -> id.equals(r.get("id").getAsString())).findFirst().orElseThrow().deepCopy();
     }
