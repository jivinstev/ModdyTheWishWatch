diff --git a/src/main/java/com/moddingfromamod/compat/StoredBlockStates.java b/src/main/java/com/moddingfromamod/compat/StoredBlockStates.java
new file mode 100644
index 0000000..59aa1c7
--- /dev/null
+++ b/src/main/java/com/moddingfromamod/compat/StoredBlockStates.java
@@ -0,0 +1,43 @@
+package com.moddingfromamod.compat;
+
+import com.google.gson.JsonObject;
+import net.minecraft.nbt.CompoundTag;
+
+/**
+ * <b>Block states a world store saved as NBT, across a Minecraft rename.</b> Moddy's own world data is not run through
+ * Minecraft's DataFixers, and {@code NbtUtils.readBlockState} reads an id this game does not have as AIR. A store that
+ * keeps block states (the build ground, the staged events' journals) stamps the Minecraft version it was written for
+ * ({@link BlockRenames#MARKER} on its root tag, none = {@link BlockRenames#PRE_MARKER}) and passes each state through
+ * {@link #renamed} before it reads it. The decision is {@link BlockRenames}' (pure, Gate A); this only carries the NBT.
+ */
+public final class StoredBlockStates {
+
+    private StoredBlockStates() {
+    }
+
+    /** The Minecraft version a store's root tag was written for. Throws when its marker is not a version. */
+    public static String writtenFor(CompoundTag root) {
+        JsonObject m = new JsonObject();
+        if (root != null && root.contains(BlockRenames.MARKER)) {
+            m.addProperty(BlockRenames.MARKER, root.getString(BlockRenames.MARKER).orElse("(not a string)"));
+        }
+        return BlockRenames.writtenFor(m);
+    }
+
+    /** Stamp this build's Minecraft on a root tag being saved. */
+    public static void stamp(CompoundTag root) {
+        root.putString(BlockRenames.MARKER, Target.MINECRAFT);
+    }
+
+    /** One saved block state with its {@code Name} as this Minecraft calls it; the same tag when nothing changes. */
+    public static CompoundTag renamed(CompoundTag state, String writtenFor) {
+        String name = state.getStringOr("Name", "");
+        String now = BlockRenames.remap(name, writtenFor, Target.MINECRAFT);
+        if (now.equals(name)) {
+            return state;
+        }
+        CompoundTag out = state.copy();
+        out.putString("Name", now);
+        return out;
+    }
+}
