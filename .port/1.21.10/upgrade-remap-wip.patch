+package com.moddingfromamod.item;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.moddingfromamod.compat.BlockRenames;
+import com.moddingfromamod.compat.Target;
+import java.util.Map;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * {@code item-specs.json} through the store's own read ({@link ItemSpecStore#adopt}) and write
+ * ({@link ItemSpecStore#designRecords}): a turn_into design saved on 1.21.8 reads its FROM/TO under 1.21.10's ids, a
+ * marked design is not remapped again, and a design a newer Minecraft wrote is read as it is and written back untouched.
+ */
+class ItemSpecBlockRenamesTest {
+
+    /** As 1.21.8 wrote them: no marker. */
+    static final String FILE = """
+            {"store":"item-specs","v":3,"specs":[
+             {"id":"gt_chain_wand","name":"Chain Wand","shape":"held","count":1,"effects":["turn_into"],
+              "params":{"FROM":"minecraft:chain","TO":"minecraft:gold_block","RADIUS":"2"}},
+             {"id":"gt_grouped","name":"Grouped","shape":"held","count":1,"effects":["turn_into","lightning"],
+              "params":{"turn_into":{"FROM":["minecraft:chain","#minecraft:logs"],"TO":"chain"},"lightning":{"HEARTS":"4"}}},
+             {"id":"gt_listed","name":"Listed","shape":"held","count":1,"effects":["turn_into"],
+              "params":{"FROM":"minecraft:chain,minecraft:stone","TO":"furnace"}},
+             {"id":"gt_marked","name":"Marked","shape":"held","count":1,"effects":["turn_into"],"mc":"1.21.10",
+              "params":{"FROM":"minecraft:chain","TO":"minecraft:stone"}},
+             {"id":"gt_newer","name":"Newer","shape":"held","count":1,"effects":["turn_into"],"mc":"1.22",
+              "params":{"FROM":"minecraft:chain","TO":"minecraft:copper_chain"}}
+            ]}""";
+
+    private JsonObject root;
+
+    @BeforeEach
+    void fresh() {
+        ItemSpecStore.clear();
+        root = JsonParser.parseString(FILE).getAsJsonObject();
+        ItemSpecStore.adopt(root.deepCopy(), Map.of());
+    }
+
+    private static JsonObject params(String id) {
+        ItemSpecStore.Spec s = ItemSpecStore.get(id);
+        assertNotNull(s, id + " was read");
+        return s.params();
+    }
+
+    private JsonObject stored(String id) {
+        for (JsonElement e : root.getAsJsonArray("specs")) {
+            if (id.equals(e.getAsJsonObject().get("id").getAsString())) {
+                return e.getAsJsonObject();
+            }
+        }
+        throw new AssertionError(id);
+    }
+
+    private static JsonObject written(String id) {
+        for (JsonElement e : ItemSpecStore.designRecords()) {
+            if (id.equals(e.getAsJsonObject().get("id").getAsString())) {
+                return e.getAsJsonObject();
+            }
+        }
+        throw new AssertionError(id + " was not written back");
+    }
+
+    @Test
+    void a_1_21_8_turn_into_design_reads_its_block_under_the_new_id() {
+        assertEquals("minecraft:iron_chain", params("gt_chain_wand").get("FROM").getAsString());
+        assertEquals("minecraft:gold_block", params("gt_chain_wand").get("TO").getAsString(), "ids not in the table pass");
+        assertEquals("2", params("gt_chain_wand").get("RADIUS").getAsString());
+        JsonObject g = params("gt_grouped").getAsJsonObject("turn_into");
+        assertEquals(JsonParser.parseString("[\"minecraft:iron_chain\",\"#minecraft:logs\"]"), g.get("FROM"));
+        assertEquals("iron_chain", g.get("TO").getAsString());
+        assertEquals("4", params("gt_grouped").getAsJsonObject("lightning").get("HEARTS").getAsString());
+    }
+
+    @Test
+    void text_that_is_not_one_id_is_left_alone() {
+        assertEquals("minecraft:chain,minecraft:stone", params("gt_listed").get("FROM").getAsString());
+        assertEquals("furnace", params("gt_listed").get("TO").getAsString());
+    }
+
+    @Test
+    void a_design_saved_with_the_marker_is_not_remapped_again() {
+        assertEquals("minecraft:chain", params("gt_marked").get("FROM").getAsString(),
+                "a 1.21.10 design is already in 1.21.10's ids");
+        JsonObject w = written("gt_chain_wand");
+        assertEquals(Target.MINECRAFT, w.get(BlockRenames.MARKER).getAsString(), "a save writes this build's marker");
+        assertEquals("minecraft:iron_chain", w.getAsJsonObject("params").get("FROM").getAsString());
+    }
+
+    @Test
+    void a_design_a_newer_minecraft_wrote_is_read_as_it_is_and_never_written_over() {
+        assertEquals("minecraft:copper_chain", params("gt_newer").get("TO").getAsString(), "read as it is");
+        assertEquals(stored("gt_newer"), written("gt_newer"), "written back exactly as it was read");
+        assertEquals(5, ItemSpecStore.designRecords().size(), "no design dropped");
+        assertFalse(written("gt_newer").get(BlockRenames.MARKER).getAsString().equals(Target.MINECRAFT),
+                "never under this build's older marker");
+    }
+}
