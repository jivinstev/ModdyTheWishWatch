--- /dev/null
+++ b/src/main/java/com/moddingfromamod/event/EventJournalRenamesGameTest.java
@@ -0,0 +1,74 @@
+package com.moddingfromamod.event;
+
+import com.moddingfromamod.ModdingFromAModMod;
+import com.moddingfromamod.testing.gt.GameTest;
+import com.moddingfromamod.testing.gt.GameTestHolder;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.gametest.framework.GameTestHelper;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.nbt.ListTag;
+import net.minecraft.nbt.NbtUtils;
+import net.minecraft.network.chat.Component;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.state.BlockState;
+
+/**
+ * <b>An event staged on 1.21.8 over a chain gives the chain back as iron_chain</b>, through the staged events' own load
+ * ({@link EventDirector.Store}); a store a newer Minecraft wrote is read, runs nothing, and is saved back unchanged.
+ */
+@GameTestHolder(ModdingFromAModMod.MODID)
+public class EventJournalRenamesGameTest {
+
+    static CompoundTag events1218(long pos) {
+        CompoundTag chain = new CompoundTag();
+        chain.putString("Name", "minecraft:chain");
+        ListTag palette = new ListTag();
+        palette.add(chain);
+        palette.add(NbtUtils.writeBlockState(Blocks.WATER.defaultBlockState()));
+        CompoundTag e = new CompoundTag();
+        e.putString("id", "gt_rename_event");
+        e.putString("dim", "minecraft:overworld");
+        e.putString("owner", "");
+        e.putString("scale", EventScale.values()[0].name());
+        e.putString("policy", EventGuard.Policy.values()[0].name());
+        e.putBoolean("restoreAtEnd", true);
+        e.putString("phase", EventPhase.values()[0].name());
+        e.put("palette", palette);
+        e.putLongArray("pos", new long[] {pos});
+        e.putIntArray("prior", new int[] {0});
+        e.putIntArray("written", new int[] {1});
+        ListTag list = new ListTag();
+        list.add(e);
+        CompoundTag tag = new CompoundTag();
+        tag.putInt("v", 1);
+        tag.put("events", list);
+        return tag;
+    }
+
+    @GameTest(template = "empty_test", batch = "block_renames", timeoutTicks = 100)
+    public static void aChainAnEventReplacedOn1218IsGivenBackAsIronChain(GameTestHelper helper) {
+        var lookup = helper.getLevel().registryAccess();
+        long pos = BlockPos.asLong(4, 5, 6);
+        EventDirector.Store s = EventDirector.Store.load(events1218(pos), lookup);
+        StagedEvent e = s.events.get("gt_rename_event");
+        helper.assertTrue(e != null && e.journal.holds(pos), Component.literal("the 1.21.8 event's cell did not read"));
+        BlockState back = e.journal.release(pos, Blocks.WATER.defaultBlockState());
+        helper.assertTrue(back != null && back.getBlock()
+                        == BuiltInRegistries.BLOCK.getValue(ResourceLocation.parse("minecraft:iron_chain")),
+                Component.literal("the event gives back " + back + ", not iron_chain"));
+        helper.assertTrue(com.moddingfromamod.compat.Target.MINECRAFT.equals(
+                        s.save(new CompoundTag(), lookup).getStringOr("mc", "")),
+                Component.literal("a save does not stamp this Minecraft"));
+
+        CompoundTag newer = events1218(pos);
+        newer.putString("mc", "1.22");
+        EventDirector.Store n = EventDirector.Store.load(newer, lookup);
+        helper.assertTrue(n.events.containsKey("gt_rename_event"), Component.literal("a newer Minecraft's event was not read"));
+        helper.assertTrue(n.refused != null, Component.literal("a newer Minecraft's events would be run and saved over"));
+        helper.assertTrue(n.save(new CompoundTag(), lookup).equals(newer),
+                Component.literal("a save wrote over a newer Minecraft's events"));
+        helper.succeed();
+    }
+}
