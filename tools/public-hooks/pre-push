#!/usr/bin/env bash
# PRE-PUSH: refuse a push whose commits ADD private work to this repository, or third-party code or text under a licence
# that is not on the allow-list (tools/licence-scan.py --range; CLAUDE.md, "Third-party code and text").
#
# Installed by tools/public-hooks/install.sh (git config core.hooksPath tools/public-hooks). For every ref being
# pushed it scans what each new commit adds (its added lines, new file names, message, author and committer) with
# tools/leak-scan.py --commits: the built-in rules always (emails, routable IPs, bucket URLs, keys and tokens,
# child's-data file names, the private side's structural markers), plus a forbidden list when one is configured
# (git config moddy.forbidden FILE, else $MODDY_FORBIDDEN_FILE, else ~/.moddy/forbidden.txt). A configured list
# that is missing refuses the push rather than scanning with fewer rules.
#
# Every commit is scanned on its own, so a leak added and deleted again in a later commit is still refused: the
# history would carry it. A finding never prints what it matched.
set -uo pipefail

remote="${1:-origin}"
top="$(git rev-parse --show-toplevel)" || exit 1
scan="$top/tools/leak-scan.py"
for f in leak-scan.py licence-scan.py licence-rules.json; do
    if [ ! -f "$top/tools/$f" ]; then
        echo "pre-push: tools/$f is missing, so nothing can be checked; refusing the push" >&2
        exit 1
    fi
done
args=()
listed="$(git config --get moddy.forbidden || true)"
[ -n "$listed" ] && args=(--forbidden "$listed")

zero="$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')"
rc=0
while read -r _lref lsha _rref rsha; do
    [ -z "${lsha:-}" ] && continue
    [ "$lsha" = "$zero" ] && continue                       # deleting a ref adds nothing
    # Only what the remote does not already have, on ANY branch: a commit it already publishes (main's, merged into a
    # version branch, whose GitHub merge metadata names the account that pressed the button) is not published again
    # by this push, so it is not this push's to refuse. Every commit new to the remote is still scanned on its own.
    if [ "$rsha" = "$zero" ]; then
        revs=("$lsha" --not "--remotes=$remote")             # a new ref: every commit the remote does not have
    else
        revs=("$lsha" --not "$rsha" "--remotes=$remote")     # an update: the same, past the ref's old head
    fi
    if ! python3 "$scan" "${args[@]}" --repo "$top" --commits -- "${revs[@]}"; then
        rc=1
    fi
    python3 "$top/tools/licence-scan.py" --repo "$top" --range -- "${revs[@]}" >&2 || rc=1
done
if [ "$rc" -ne 0 ]; then
    echo "pre-push: REFUSED. A commit above adds private work or code under a licence off the allow-list (or a scan" >&2
    echo "pre-push: could not run). Fix the commit itself:" >&2
    echo "pre-push: a later commit that deletes it still leaves it in the history." >&2
fi
exit "$rc"
