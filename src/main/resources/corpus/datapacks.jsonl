{"id": "cbs_mutant_illusioner_e1754d", "featureId": "mutant_illusioner", "observed": "compiles", "errorClass": null, "errorNeedle": null, "previously": null, "reconciled": null, "sourceSha": "e1754d874abd", "source": "import common\n\nreset\n    mi_t = 0\nend\n\nfunction spawn()\n    /summon minecraft:illusioner ~ ~1 ~7 {Tags:[\"mutant_illu\"],Glowing:1b,PersistenceRequired:1b,CustomName:'{\"text\":\"MUTANT ILLUSIONER\",\"color\":\"blue\",\"bold\":true}',CustomNameVisible:1b,Health:300f,attributes:[{id:\"minecraft:max_health\",base:300},{id:\"minecraft:scale\",base:3.0},{id:\"minecraft:knockback_resistance\",base:1.0},{id:\"minecraft:movement_speed\",base:0.42}]}\n    /playsound minecraft:entity.illusioner.prepare_blindness master @a ~ ~ ~ 4 0.6\nend\n\nclock tick\n    mi_t = mi_t + 1\n\n    /execute as @e[type=illusioner,tag=!mutant_illu] run tag @s add mutant_illu\n\n    as @e[tag=mutant_illu] at @s\n        /particle minecraft:witch ~ ~2 ~ 1.5 2 1.5 0.01 8 force\n        /particle minecraft:enchant ~ ~3 ~ 1.5 1.5 1.5 0.5 6 force\n    end\n\n    if mi_t > 120\n        mi_t = 0\n        as @e[tag=mutant_illu] at @s\n            /execute if entity @p[distance=..24] unless entity @e[type=vex,limit=8] run summon minecraft:vex ~1 ~2 ~ {Tags:[\"mutant_vex\"]}\n            /execute if entity @p[distance=..24] unless entity @e[type=vex,limit=8] run summon minecraft:vex ~-1 ~2 ~ {Tags:[\"mutant_vex\"]}\n            /execute if entity @p[distance=..24] run particle minecraft:dust{color:[0.35,0.35,0.95],scale:2.0} ~ ~1 ~ 5 1 5 0 250 force\n            /execute if entity @p[distance=..24] run particle minecraft:explosion ~ ~1 ~ 3 1 3 0 10 force\n            /execute if entity @p[distance=..24] run playsound minecraft:entity.illusioner.cast_spell master @a ~ ~ ~ 4 0.5\n            /execute as @a[distance=..6] run damage @s 4 minecraft:magic\n            /execute as @a[distance=..14] run effect give @s minecraft:blindness 2 0 true\n        end\n    end\nend"}
