{"id": "cbs_yoshi_egg_ab9c35", "featureId": "yoshi_egg", "observed": "compiles", "errorClass": null, "errorNeedle": null, "previously": null, "reconciled": null, "sourceSha": "ab9c355c0c41", "source": "define @Yoshis = @e[tag=wishmob_yoshi]\nend\n\nfunction throw()\n    /playsound minecraft:entity.chicken.egg neutral @a ~ ~ ~ 3.0 1.3\n    /playsound minecraft:entity.chicken.hurt neutral @a ~ ~ ~ 1.5 1.6\n    /particle minecraft:happy_villager ~ ~ ~ 0.25 0.25 0.25 0.05 14 force\n    /summon minecraft:egg ~ ~ ~ {Tags:[\"yegg\"]}\nend\n\nfunction egghit()\n    /execute if entity @e[tag=wishmob_bowser,distance=..3.0] run particle minecraft:explosion ~ ~ ~ 0.4 0.4 0.4 0.0 8 force\n    /execute if entity @e[tag=wishmob_bowser,distance=..3.0] run particle minecraft:happy_villager ~ ~ ~ 0.6 0.6 0.6 0.1 20 force\n    /execute if entity @e[tag=wishmob_bowser,distance=..3.0] run playsound minecraft:entity.generic.explode hostile @a ~ ~ ~ 2.0 1.5\n    /execute as @e[tag=wishmob_bowser,distance=..3.0] run damage @s 25 minecraft:magic\n    /execute if entity @e[tag=wishmob_bowser,distance=..3.0] run kill @s\nend\n\nclock tick\n    /execute as @e[tag=yegg] at @s facing entity @e[tag=wishmob_bowser,limit=1,sort=nearest] eyes run tp @s ^0 ^0 ^1.3\n    as @e[tag=yegg] at @s\n        /particle minecraft:happy_villager ~ ~ ~ 0.15 0.15 0.15 0.01 4 force\n        /particle minecraft:end_rod ~ ~ ~ 0.06 0.06 0.06 0.0 2 force\n        @s.yeggage = @s.yeggage + 1\n        if @s.yeggage > 120\n            /kill @s\n        end\n        egghit()\n    end\n    /execute as @Yoshis at @s if entity @e[tag=wishmob_bowser,distance=..70] facing entity @e[tag=wishmob_bowser,limit=1,sort=nearest] run tp @s ~ ~ ~ ~ 0\n    /execute as @Yoshis at @s if entity @e[tag=wishmob_bowser,distance=..70] unless entity @e[tag=wishmob_bowser,distance=..8] run tp @s ^0 ^0 ^0.15\n    as @Yoshis at @s\n        @s.yocd = @s.yocd + 1\n        if @s.yocd > 18\n            @s.yocd = 0\n            /execute if entity @e[tag