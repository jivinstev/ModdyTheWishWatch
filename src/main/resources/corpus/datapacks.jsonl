{"id": "cbs_trex_chomp_d6e70e", "featureId": "trex_chomp", "observed": "compiles", "errorClass": null, "errorNeedle": null, "previously": null, "reconciled": null, "sourceSha": "d6e70e4e067b", "source": "reset\n    chomp_t = 0\n    shake_t = 0\n    cool_t = 999\nend\n\nclock tick\n    /execute unless entity @a[tag=trex_chomped] as @e[tag=wishmob_trex_king,limit=1] at @s run tag @a[distance=..11,tag=!trex_safe,limit=1,sort=nearest] add trex_chomped\n\n    as @a[tag=trex_chomped]\n        chomp_t = chomp_t + 1\n    end\n\n    if chomp_t < 2\n        /execute as @a[tag=trex_chomped] at @s run playsound minecraft:entity.ravager.bite master @a ~ ~ ~ 1.0 0.5\n    end\n\n    shake_t = shake_t + 1\n    if shake_t > 3\n        shake_t = 0\n    end\n\n    /effect give @a[tag=trex_chomped] minecraft:resistance 2 3 true\n\n    if shake_t < 2\n        /execute as @e[tag=wishmob_trex_king,limit=1] at @s positioned ^0.7 ^6.75 ^6.33 run tp @a[tag=trex_chomped] ~ ~ ~ ~12 ~6\n    end\n    if shake_t > 1\n        /execute as @e[tag=wishmob_trex_king,limit=1] at @s positioned ^-0.7 ^6.75 ^6.33 run tp @a[tag=trex_chomped] ~ ~ ~ ~-12 ~-6\n    end\n    /execute as @e[tag=wishmob_trex_king,limit=1] at @s positioned ^0 ^6.75 ^6.33 run particle minecraft:crit ~ ~ ~ 0.6 0.5 0.6 0.1 10 force\n\n    if chomp_t > 80\n        chomp_t = 0\n        cool_t = 0\n        /execute as @a[tag=trex_chomped] at @s run playsound minecraft:entity.ender_dragon.growl master @a ~ ~ ~ 1.0 0.6\n        /effect give @a[tag=trex_chomped] minecraft:slow_falling 10 0 true\n        /tag @a[tag=trex_chomped] add trex_safe\n        /tag @a[tag=trex_chomped] remove trex_chomped\n    end\n\n    cool_t = cool_t + 1\n    if cool_t > 200\n        /tag @a remove trex_safe\n    end\nend\n"}
{"id": "cbs_icy_blizzard_110512", "featureId": "icy_blizzard", "observed": "compiles", "errorClass": null, "errorNeedle": null, "previously": null, "reconciled": null, "sourceSha": "110512834fe9", "source": "import common\n\nreset\n    bliz_t = 0\nend\n\nfunction blizzard()\n    /weather rain 1200\n    as @a at @s\n        /fillbiome ~-40 ~-20 ~-40 ~40 ~30 ~40 minecraft:snowy_taiga\n        /particle minecraft:snowflake ~ ~3 ~ 10 5 10 0.05 500 force\n        /particle minecraft:cloud ~ ~5 ~ 8 2 8 0.01 80 force\n        /playsound minecraft:entity.player.hurt_freeze master @s ~ ~ ~ 1 0.6\n        /effect give @s minecraft:slowness 4 0 true\n    end\nend\n\nclock tick\n    bliz_t = bliz_t + 1\n\n    as @e[tag=wishmob_icy_mage,tag=!bliz_init] at @s\n        /tag @s add bliz_init\n        /fillbiome ~-40 ~-20 ~-40 ~40 ~30 ~40 minecraft:snowy_taiga\n        /weather rain 2400\n    end\n\n    as @e[tag=wishmob_icy_mage] at @s\n        /particle minecraft:snowflake ~ ~2 ~ 6 3 6 0.06 70 force\n        /particle minecraft:cloud ~ ~4 ~ 5 1 5 0.01 10 force\n        /particle minecraft:end_rod ^0 ^3.5 ^0 0.15 0.15 0.15 0.01 4 force\n        /execute as @a[distance=..16] run effect give @s minecraft:slowness 2 1 true\n        /execute as @e[distance=..16,tag=!wishmob_icy_mage,type=!player,type=!item,type=!experience_orb] run data merge entity @s {TicksFrozen:180}\n    end\n\n    if bliz_t > 20\n        bliz_t = 0\n        as @e[tag=wishmob_icy_mage] at @s\n            /execute as @a[distance=..14] run damage @s 1 minecraft:freeze\n            /execute as @e[distance=..14,tag=!wishmob_icy_mage,type=!player,type=!item,type=!experience_orb] run damage @s 2 minecraft:freeze\n        end\n    end\nend"}
{"id": "cbs_fire_ghost_a5717e", "featureId": "fire_ghost", "observed": "compiles", "errorClass": null, "errorNeedle": null, "previously": null, "reconciled": null, "sourceSha": "a5717e876a6e", "source": "import common\n\nreset\n    fg_alive = 0\nend\n\nfunction boom()\n    /particle minecraft:explosion_emitter ~ ~ ~ 2 2 2 0 6 force\n    /particle minecraft:lava ~ ~ ~ 3 3 3 0.05 80 force\n    /particle minecraft:flame ~ ~ ~ 4 4 4 0.15 200 force\n    /playsound minecraft:entity.generic.explode master @a ~ ~ ~ 4 0.7\n    /fill ~-3 ~-2 ~-3 ~3 ~2 ~3 minecraft:fire replace air\n    /execute as @e[distance=..7,type=!item,type=!experience_orb,type=!marker] run damage @s 5 minecraft:on_fire\nend\n\nfunction spawn()\n    /summon minecraft:ghast ~ ~6 ~ {Tags:[\"fireghost\",\"fg_setup\"],ExplosionPower:3,Glowing:1b,PersistenceRequired:1b}\n    /summon minecraft:marker ~ ~6 ~ {Tags:[\"fg_mark\"]}\n    /playsound minecraft:entity.ghast.scream master @a ~ ~ ~ 3 0.8\nend\n\nclock tick\n    fg_alive = 0\n\n    /execute as @e[type=ghast,tag=!fg_setup] run data merge entity @s {ExplosionPower:3,Glowing:1b,PersistenceRequired:1b}\n    /execute as @e[type=ghast,tag=!fg_setup] run tag @s add fireghost\n    /execute as @e[type=ghast,tag=!fg_setup] run tag @s add fg_setup\n    /execute at @e[tag=fireghost,limit=1] unless entity @e[type=marker,tag=fg_mark] run summon minecraft:marker ~ ~ ~ {Tags:[\"fg_mark\"]}\n\n    as @e[tag=fireghost] at @s\n        fg_alive = 1\n        /particle minecraft:flame ~ ~ ~ 1.6 1.6 1.6 0.02 40 force\n        /particle minecraft:lava ~ ~ ~ 1 1 1 0.01 2 force\n        /particle minecraft:soul_fire_flame ~ ~ ~ 1.2 1.2 1.2 0.01 10 force\n        /tp @e[type=marker,tag=fg_mark] ~ ~ ~\n    end\n\n    if fg_alive < 1\n        as @e[type=marker,tag=fg_mark] at @s\n            boom()\n            /kill @s\n        end\n    end\nend"}
