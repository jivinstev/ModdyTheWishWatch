{"id": "cbs_sparkle_bomb_fcbdca", "featureId": "sparkle_bomb", "observed": "compiles", "errorClass": null, "errorNeedle": null, "previously": null, "reconciled": null, "sourceSha": "fcbdcae66bb1", "source": "import common\n\ndefine @SparkleBomb = @e[type=snowball, tag=sbomb]\nend\n\ndefine @SparkleMark = @e[type=marker, tag=sbmark]\nend\n\nfunction give()\n    /give @s snowball[minecraft:custom_name='{\"text\":\"Sparkle Bomb\",\"color\":\"light_purple\",\"italic\":false}',minecraft:custom_data={sparkle_bomb:1b},minecraft:enchantment_glint_override=true] 32\nend\n\nfunction greet()\n    /tellraw @s [\"\",{\"text\":\"Sparkle Bombs! Throw one and it BURSTS into fireworks. \",\"color\":\"light_purple\"},{\"text\":\"[Click for more]\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"run_command\",\"value\":\"/function sparkle_bomb:give\"}}]\nend\n\nfunction burst()\n    /effect give @a[distance=..10] minecraft:resistance 2 4 true\n    /playsound minecraft:entity.firework_rocket.large_blast ambient @a ~ ~ ~ 3 1\n    /particle minecraft:firework ~ ~1 ~ 1 1 1 0.35 120 force\n    /summon minecraft:firework_rocket ~ ~0.6 ~ {LifeTime:0,FireworksItem:{id:\"minecraft:firework_rocket\",count:1,components:{\"minecraft:fireworks\":{explosions:[{shape:\"large_ball\",colors:[I;16711680,16776960,65280,255],fade_colors:[I;16711935,65535],has_trail:true,has_twinkle:true}]}}}}\n    /summon minecraft:firework_rocket ~ ~1.2 ~ {LifeTime:0,FireworksItem:{id:\"minecraft:firework_rocket\",count:1,components:{\"minecraft:fireworks\":{explosions:[{shape:\"star\",colors:[I;16711935,16744192,65535],fade_colors:[I;16777215],has_trail:true,has_twinkle:true}]}}}}\n    /summon minecraft:firework_rocket ~ ~1.8 ~ {LifeTime:0,FireworksItem:{id:\"minecraft:firework_rocket\",count:1,components:{\"minecraft:fireworks\":{explosions:[{shape:\"burst\",colors:[I;65280,255,16776960],fade_colors:[I;16711680,16711935],has_trail:true,has_twinkle:true}]}}}}\n    /kill @s\nend\n\nclock tick\n    as @a[tag=!sbomb_greeted]\n        /tag @s add sbomb_greeted\n        greet()\n    end\n    /execute as @e[type=snowball,tag=!sbomb,nbt={Item:{components:{\"minecraft:custom_data\":{sparkle_bomb:1b}}}}] run tag @s add sbomb\n    as @SparkleBomb at @s\n        /particle minecraft:firework ~ ~ ~ 0.1 0.1 0.1 0.02 8 force\n        /particle minecraft:totem_of_undying ~ ~ ~ 0.1 0.1 0.1 0.05 4 force\n        /kill @e[type=minecraft:marker,tag=sbmark,distance=..8]\n        /summon minecraft:marker ~ ~ ~ {Tags:[\"sbmark\"]}\n    end\n    /execute as @e[type=minecraft:marker,tag=sbmark] at @s unless entity @e[type=snowball,tag=sbomb,distance=..8] run function sparkle_bomb:burst\nend\n"}
