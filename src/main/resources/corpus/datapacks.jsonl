{"id": "cbs_ronald_food_ce0eab", "featureId": "ronald_food", "observed": "fails", "errorClass": "datapack-policy", "errorNeedle": "every player at once", "previously": "compiles", "reconciled": "refused since #1605 step 2 (2026-10-17): `give @a` hands every child in the world the burgers; a wish touches only the child who made it. The one pack of 178 the rule refuses.", "sourceSha": "ce0eabb5bb7f", "source": "reset\n    /scoreboard objectives add foodcd dummy\nend\n\nclock tick\n    /execute as @a run scoreboard players add @s foodcd 0\n    /execute as @a if score @s foodcd matches 1.. run scoreboard players remove @s foodcd 1\n    /execute as @a[nbt={Sneaking:1b}] at @s if score @s foodcd matches 0 if entity @e[tag=wishmob_ronald_mcdonald,distance=..5,type=!minecraft:item_display,type=!minecraft:block_display,type=!minecraft:text_display,type=!minecraft:interaction] run function ronald_food:handout\nend\n\nfunction handout()\n    /scoreboard players set @s foodcd 100\n    /give @s minecraft:cooked_beef[minecraft:custom_name='{\"text\":\"Big Burger\",\"color\":\"gold\",\"italic\":false}'] 3\n    /give @s minecraft:baked_potato[minecraft:custom_name='{\"text\":\"Hot Fries\",\"color\":\"yellow\",\"italic\":false}'] 3\n    /playsound minecraft:entity.villager.yes master @s ~ ~ ~ 1 1.3\n    /particle minecraft:happy_villager ~ ~1 ~ 0.5 0.5 0.5 0.1 20 force\n    /tellraw @s [\"\",{\"text\":\"Ronald: \",\"color\":\"red\",\"bold\":true},{\"text\":\"Here you go! Enjoy your burger and fries!\",\"color\":\"yellow\"}]\nend\n\nfunction give()\n    /give @a minecraft:cooked_beef[minecraft:custom_name='{\"text\":\"Big Burger\",\"color\":\"gold\",\"italic\":false}'] 8\n    /give @a minecraft:baked_potato[minecraft:custom_name='{\"text\":\"Hot Fries\",\"color\":\"yellow\",\"italic\":false}'] 8\n    /give @a minecraft:honey_bottle[minecraft:custom_name='{\"text\":\"Milkshake\",\"color\":\"light_purple\",\"italic\":false}'] 3\n    /execute as @a at @s run playsound minecraft:entity.villager.yes master @s ~ ~ ~ 1 1.3\n    /execute as @a at @s run particle minecraft:happy_villager ~ ~1 ~ 0.5 0.5 0.5 0.1 25 force\n    /tellraw @a [\"\",{\"text\":\"Ronald: \",\"color\":\"red\",\"bold\":true},{\"text\":\"Burgers, fries and a milkshake — enjoy!\",\"color\":\"yellow\"}]\nend\n"}
