{"id": "cbs_blizzard_magic_65a01f", "featureId": "blizzard_magic", "observed": "compiles", "errorClass": null, "errorNeedle": null, "previously": null, "reconciled": null, "sourceSha": "65a01f6c6573", "source": "import common\n\ndefine @Mages = @e[tag=wishmob_frost_mage]\nend\n\nfunction storm_at()\n    /particle minecraft:snowflake ~ ~3 ~ 12 5 12 0.02 240 force\n    /particle minecraft:white_ash ~ ~4 ~ 12 5 12 0.06 100 force\n    /execute as @a[distance=..16] run effect give @s minecraft:slowness 2 0 true\n    /execute as @a[distance=..16] at @s run particle minecraft:snowflake ~ ~1 ~ 0.7 1.1 0.7 0.03 30 force\n    /execute as @e[distance=..16,type=!minecraft:player,type=!minecraft:item,type=!minecraft:marker,type=!minecraft:experience_orb,tag=!wishmob_frost_mage] run effect give @s minecraft:slowness 2 1 true\nend\n\nfunction snowfall_at()\n    /fill ~-10 ~ ~-10 ~10 ~ ~10 minecraft:snow replace minecraft:air\n    /playsound minecraft:weather.rain master @a ~ ~ ~ 0.7 0.6\n    /execute as @e[distance=..14,type=!minecraft:player,type=!minecraft:item,type=!minecraft:marker,type=!minecraft:experience_orb,type=!minecraft:item_display,type=!minecraft:block_display,type=!minecraft:text_display,tag=!wishmob_frost_mage] run damage @s 1 minecraft:freeze\nend\n\nfunction blizzard()\n    stormtimer = 600\n    /weather rain 900\n    /playsound minecraft:entity.player.hurt_freeze master @a ~ ~ ~ 1.0 0.7\n    /tellraw @a {\"text\":\"A BLIZZARD ROARS IN! Hold on! \u2744\",\"color\":\"aqua\"}\nend\n\nfunction storm_pulse()\n    stormtimer = stormtimer - 1\n    at @a\n        storm_at()\n    end\nend\n\nfunction slow_pulse()\n    ticker = 0\n    /execute if entity @e[tag=wishmob_frost_mage] run weather rain 200\n    as @Mages at @s\n        snowfall_at()\n    end\n    if stormtimer > 0\n        at @a\n            snowfall_at()\n        end\n    end\nend\n\nreset\n    stormtimer = 0\n    ticker = 0\nend\n\nclock tick\n    ticker = ticker + 1\n    as @Mages at @s\n        storm_at()\n    end\n    if stormtimer > 0\n        storm_pulse()\n    end\n    if ticker > 19\n        slow_pulse()\n    end\nend\n"}
