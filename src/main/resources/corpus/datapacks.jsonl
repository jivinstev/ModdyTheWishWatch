{"id": "cbs_icy_blizzard_0682f6", "featureId": "icy_blizzard", "observed": "compiles", "errorClass": null, "errorNeedle": null, "previously": null, "reconciled": null, "sourceSha": "0682f6744780", "source": "define @Mages = @e[tag=wishmob_icy_mage]\nend\n\nfunction storm()\n    as @a at @s\n        /particle minecraft:snowflake ~ ~2 ~ 10 5 10 0.06 500 force\n        /particle minecraft:white_ash ~ ~4 ~ 10 5 10 0.1 250 force\n        /playsound minecraft:entity.player.hurt_freeze master @a ~ ~ ~ 2 0.6\n        /execute as @e[distance=..16,type=!player,type=!item] run effect give @s minecraft:slowness 6 2 true\n        /execute as @e[distance=..16,type=!player,type=!item] run damage @s 3 minecraft:freeze\n    end\nend\n\nreset\n    bt = 0\nend\n\nclock tick\n    bt = bt + 1\n    as @Mages at @s\n        /particle minecraft:snowflake ~ ~2 ~ 8 4 8 0.03 70 force\n        /particle minecraft:white_ash ~ ~4 ~ 9 3 9 0.06 30 force\n        /execute positioned ^-1 ^4.8 ^0 run particle minecraft:snowflake ~ ~ ~ 0.2 0.2 0.2 0.08 14 force\n        /execute positioned ^-1 ^4.8 ^0 run particle minecraft:end_rod ~ ~ ~ 0.1 0.1 0.1 0.01 3 force\n    end\n    if bt >= 20\n        bt = 0\n        as @Mages at @s\n            /execute as @e[distance=..14,type=!player,type=!item,type=!snowball,tag=!wishmob_icy_mage] run damage @s 2 minecraft:freeze\n            /execute as @e[distance=..14,type=!player,type=!item,tag=!wishmob_icy_mage] run effect give @s minecraft:slowness 3 1 true\n            /execute as @e[distance=..14,type=!player,type=!item,tag=!wishmob_icy_mage] run data merge entity @s {TicksFrozen:160}\n            /execute as @a[distance=..14] run effect give @s minecraft:slowness 2 0 true\n            /playsound minecraft:weather.rain master @a ~ ~ ~ 1.5 0.5\n        end\n    end\nend"}
{"id": "cbs_icy_blizzard_800810", "featureId": "icy_blizzard", "observed": "compiles", "errorClass": null, "errorNeedle": null, "previously": null, "reconciled": null, "sourceSha": "800810054ead", "source": "define @Mages = @e[tag=wishmob_icy_mage]\nend\n\nfunction storm()\n    as @a at @s\n        /particle minecraft:snowflake ~ ~3 ~ 18 8 18 0.08 900 force\n        /particle minecraft:white_ash ~ ~6 ~ 20 8 20 0.12 500 force\n        /playsound minecraft:entity.player.hurt_freeze master @a ~ ~ ~ 3 0.6\n        /execute as @e[distance=..26,type=!player,type=!item] run effect give @s minecraft:slowness 8 2 true\n        /execute as @e[distance=..26,type=!player,type=!item] run damage @s 3 minecraft:freeze\n    end\nend\n\nreset\n    bt = 0\nend\n\nclock tick\n    bt = bt + 1\n    as @Mages at @s\n        /particle minecraft:snowflake ~ ~3 ~ 18 8 18 0.04 240 force\n        /particle minecraft:white_ash ~ ~6 ~ 20 7 20 0.08 120 force\n        /particle minecraft:snowflake ~ ~10 ~ 26 12 26 0.05 90 force\n        /particle minecraft:snowflake ~ ~18 ~ 10 10 10 0.06 60 force\n        /execute positioned ^-1 ^4.8 ^0 run particle minecraft:snowflake ~ ~ ~ 0.3 0.3 0.3 0.12 30 force\n        /execute positioned ^-1 ^4.8 ^0 run particle minecraft:end_rod ~ ~ ~ 0.1 0.1 0.1 0.01 4 force\n    end\n    if bt >= 20\n        bt = 0\n        as @Mages at @s\n            /execute as @e[distance=..26,type=!player,type=!item,type=!snowball,tag=!wishmob_icy_mage] run damage @s 2 minecraft:freeze\n            /execute as @e[distance=..26,type=!player,type=!item,tag=!wishmob_icy_mage] run effect give @s minecraft:slowness 3 1 true\n            /execute as @e[distance=..26,type=!player,type=!item,tag=!wishmob_icy_mage] run data merge entity @s {TicksFrozen:200}\n            /execute as @a[distance=..26] run effect give @s minecraft:slowness 2 0 true\n            /playsound minecraft:weather.rain master @a ~ ~ ~ 3 0.5\n        end\n    end\nend"}
