{"id": "cbs_stalker_enderman_8f1684", "featureId": "stalker_enderman", "observed": "compiles", "errorClass": null, "errorNeedle": null, "previously": null, "reconciled": null, "sourceSha": "8f1684d452df", "source": "import common\n\nreset\n    ender_t = 0\nend\n\nfunction spawn()\n    /summon minecraft:enderman ~ ~1 ~6 {Tags:[\"stalker\"],Glowing:1b,PersistenceRequired:1b,CustomNameVisible:1b}\n    /playsound minecraft:entity.enderman.stare master @a ~ ~ ~ 2 1\nend\n\nclock tick\n    ender_t = ender_t + 1\n\n    /execute as @e[type=enderman,tag=!stalker] run tag @s add stalker\n\n    as @e[tag=stalker] at @s\n        /particle minecraft:portal ~ ~1 ~ 0.6 1 0.6 0.05 10 force\n    end\n\n    if ender_t > 160\n        ender_t = 0\n        as @e[tag=stalker] at @s\n            /particle minecraft:portal ~ ~1 ~ 0.8 1.5 0.8 0.15 90 force\n            /execute at @p rotated as @p rotated ~ 0 positioned ^0 ^0 ^-3 run tp @s ~ ~ ~ facing entity @p\n            /execute at @s run particle minecraft:portal ~ ~1 ~ 0.8 1.5 0.8 0.15 90 force\n            /execute at @s run playsound minecraft:entity.enderman.teleport master @a ~ ~ ~ 2 1\n            /execute at @s run effect give @a[distance=..12] minecraft:blindness 3 0 true\n            /execute at @s run playsound minecraft:entity.enderman.stare master @a[distance=..12] ~ ~ ~ 1.5 0.9\n        end\n    end\nend"}
