{"id": "cbs_sparkle_bomb_b7c4e0", "featureId": "sparkle_bomb", "observed": "fails", "errorClass": "unless-entity", "errorNeedle": "Unexpected ATID symbol \"e\"", "previously": null, "reconciled": null, "sourceSha": "b7c4e0729561", "source": "import common\n\nfunction give()\n    /give @s minecraft:snowball[minecraft:custom_name='{\"text\":\"Sparkle Bomb\",\"color\":\"light_purple\",\"italic\":false}',minecraft:custom_data={sparklebomb:1b},minecraft:enchantment_glint_override=true] 32\nend\n\nfunction greet()\n    /tellraw @s [\"\",{\"text\":\"Sparkle Bombs ready! \",\"color\":\"light_purple\"},{\"text\":\"[Click for Sparkle Bombs]\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"run_command\",\"value\":\"/function sparkle_bomb:give\"}}]\nend\n\nfunction burst()\n    /execute as @a[distance=..10] run effect give @s minecraft:resistance 3 4 true\n    /playsound minecraft:entity.firework_rocket.large_blast master @a ~ ~ ~ 3 1\n    /playsound minecraft:entity.firework_rocket.twinkle master @a ~ ~ ~ 3 1\n    /particle minecraft:firework ~ ~1 ~ 0.7 0.7 0.7 0.4 150 force\n    /particle minecraft:totem_of_undying ~ ~1 ~ 0.5 0.5 0.5 0.4 80 force\n    /particle minecraft:end_rod ~ ~1 ~ 0.4 0.4 0.4 0.3 50 force\n    /summon minecraft:firework_rocket ~ ~1 ~ {LifeTime:0,FireworksItem:{id:\"minecraft:firework_rocket\",count:1,components:{\"minecraft:fireworks\":{explosions:[{shape:\"large_ball\",colors:[I;16711680,16776960,65280],fade_colors:[I;16777215],has_trail:true,has_twinkle:true}],flight_duration:1}}}}\n    /summon minecraft:firework_rocket ~ ~2 ~ {LifeTime:0,FireworksItem:{id:\"minecraft:firework_rocket\",count:1,components:{\"minecraft:fireworks\":{explosions:[{shape:\"star\",colors:[I;255,16711935,65535],fade_colors:[I;16776960],has_trail:true,has_twinkle:true}],flight_duration:1}}}}\n    /summon minecraft:firework_rocket ~ ~1 ~ {LifeTime:0,FireworksItem:{id:\"minecraft:firework_rocket\",count:1,components:{\"minecraft:fireworks\":{explosions:[{shape:\"burst\",colors:[I;65535,16777215,16711680],fade_colors:[I;255],has_trail:true,has_twinkle:true}],flight_duration:1}}}}\nend\n\nclock tick\n    as @a[tag=!sparkle_greeted]\n        /tag @s add sparkle_greeted\n        greet()\n    end\n    /execute as @e[type=snowball,tag=!sbomb,nbt={Item:{components:{\"minecraft:custom_data\":{sparklebomb:1b}}}}] run tag @s add sbomb\n    as @e[type=snowball, tag=sbomb] at @s\n        /particle minecraft:end_rod ~ ~ ~ 0.1 0.1 0.1 0.01 6 force\n        /particle minecraft:dust_color_transition{from_color:[1.0,0.2,0.9],to_color:[0.2,0.9,1.0],scale:1.3} ~ ~ ~ 0.15 0.15 0.15 0 10 force\n        /kill @e[type=marker,tag=sbmark,distance=..6]\n        /summon minecraft:marker ~ ~ ~ {Tags:[\"sbmark\"]}\n    end\n    as @e[type=marker, tag=sbmark] at @s\n        unless entity @e[type=snowball,tag=sbomb,distance=..6]\n            burst()\n            /kill @s\n        end\n    end\nend\n"}
