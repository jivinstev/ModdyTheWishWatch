nt:1b,Invulnerable:1b}\n    /execute as @e[tag=wishmob_fire_ghost] at @s run playsound minecraft:entity.ghast.shoot master @a ~ ~ ~ 2.0 0.9\n    /execute as @e[tag=wishmob_fire_ghost] at @s positioned ^0 ^6.38 ^1.38 run particle minecraft:flame ~ ~ ~ 0.5 0.5 0.5 0.15 80 force\nend\n\nfunction ghost_tick()\n    /particle minecraft:flame ~ ~1 ~ 0.7 1.0 0.7 0.02 30 force\n    /particle minecraft:lava ~ ~1 ~ 0.4 0.7 0.4 0.0 2 force\n    /particle minecraft:soul_fire_flame ~ ~2 ~ 0.5 0.5 0.5 0.01 6 force\n    /execute unless entity @e[tag=fg_track,distance=..2] run summon minecraft:marker ~ ~ ~ {Tags:[\"fg_track\"]}\n    /execute as @e[tag=fg_track,distance=..4,limit=1,sort=nearest] run tp @s ~ ~ ~\n    /execute as @e[distance=..3,type=!minecraft:player,type=!minecraft:marker,type=!minecraft:armor_stand,type=!minecraft:item,type=!minecraft:experience_orb,tag=!wishmob_fire_ghost] run damage @s 2 minecraft:on_fire\nend\n\nreset\n    ballclock = 0\n    /scoreboard objectives add gballage dummy\nend\n\nclock tick\n    ballclock = ballclock + 1\n    as @Ghosts at @s\n        ghost_tick()\n    end\n    /execute as @e[tag=fg_track] at @s unless entity @e[tag=wishmob_fire_ghost,distance=..3] run function fire_ghost_boom:boom\n    /execute as @e[tag=gball] at @s facing entity @p eyes run tp @s ^ ^ ^0.5\n    /execute as @e[tag=gball] at @s run particle minecraft:flame ~ ~ ~ 0.25 0.25 0.25 0.01 22 force\n    /execute as @e[tag=gball] at @s run particle minecraft:lava ~ ~ ~ 0.12 0.12 0.12 0.0 1 force\n    /execute as @e[tag=gball] at @s run particle minecraft:large_smoke ~ ~ ~ 0.2 0.2 0.2 0.01 4 force\n    /execute as @e[tag=gball] at @s if entity @p[distance=..1.6] run function fire_ghost_boom:ballboom\n    /execute as @e[tag=gball] at @s unless block ~ ~ ~ #minecraft:replaceable run function fire_ghost_boom:ballboom\n    /execute as @e[tag=gball] run scoreboard players add @s gballage 1\n    /execute as @e[tag=gball,scores={gballage=120..}] run kill @s\n    if ballclock > 49\n    